# Copia este archivo a .env y complétalo — docker compose lo lee solo.
#   cp .env.example .env

# ── Secretos ──
OPENAI_API_KEY=            # key de Tinfoil (inference.tinfoil.sh)
HF_TOKEN=                   # token de HuggingFace — solo si usas pyannote
MCP_CLIENT_ID=              # credenciales OAuth del MCP de Fortemi
MCP_CLIENT_SECRET=
POSTGRES_PASSWORD=fortemi-local-dev   # local-dev; cámbiala en serio

# ── Rutas del host (los volúmenes del override) ──
DICTADOS_DIR=               # carpeta donde caen los audios a capturar
PROTESIS_DIR=               # carpeta de estado del sistema
LIBROS_DIR=                 # catálogo de libros
LIBROS_SYNC_DIR=            # estante sincronizado con KOReader
CAJAS_DIR=                  # inbox/procesados del black boxer
DELTAS_DIR=                 # inbox/applied/acuses del daemon-delta
N3_REPORTS_DIR=             # reportes de las corridas de Élenchos
